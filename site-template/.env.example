# Copy to .env and fill in. Never commit .env.

# The ESP32 master node on this site's Wi-Fi (use its IP address; containers cannot resolve .local names)
MASTER_URL=http://192.168.1.50

# Shown in the app and on the hub
SITE_NAME=UTHM Batu Pahat
SITE_LOGO=/logo.png

# Given to you by the hub admin (see README.md in this folder). All three are required.
HUB_URL=https://jaga.larmkx.com
SITE_SLUG=uthm-batu-pahat
SITE_TOKEN=paste-the-token-here

# Water levels this site publishes to the app (mm above the drain floor).
# Users see these as the defaults; they can override them in the app unless they leave overwrite protection off.
WARN_MM=700
DANGER_MM=900
DEPTH_MM=1200
